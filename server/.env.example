# Copy this file to server/.env (git-ignored) and fill in real values there.
# NEVER put real keys in this example file: it is committed to git.

# Port to run the Express backend on
PORT=3000

# Set NODE_ENV=production on the live server (Render). In production, mock auth tokens,
# the sandbox OTP simulation and permissive CORS are always disabled.
NODE_ENV=development

# Comma-separated list of web origins allowed to call this API in production
ALLOWED_ORIGINS=https://your-domain.example

# Firebase Project Configuration
FIREBASE_PROJECT_ID=osudsheba-7b88a

# Allow "mock_token_for_<uid>" auth tokens for local testing only (ignored in production)
ALLOW_MOCK_AUTH=false

# AppsPro Subscription Configuration (BDApps Direct Carrier Billing)
APPSPRO_BASE_URL=https://api.appspro.dev/api/v1
APPSPRO_PUBLISHABLE_KEY=pk_your_publishable_key
APPSPRO_SECRET_KEY=sk_your_secret_key
APPSPRO_APP_ID=your_app_id
APPSPRO_WEBHOOK_SECRET=
APPSPRO_ENV=production

# Local-only: accept OTP 000000 without charging (never enable on a live server;
# ignored whenever NODE_ENV=production)
APPSPRO_ALLOW_SIMULATION=false

# Optional: enables GET /subscription/diagnostic for operators.
# Requires header x-diagnostics-token. Use a long random value (32+ chars) or leave empty to disable.
DIAGNOSTICS_TOKEN=

# Optional: where the local JSON fallback store lives (used only when Firestore is unavailable)
# SUBSCRIPTION_DATA_DIR=./data
